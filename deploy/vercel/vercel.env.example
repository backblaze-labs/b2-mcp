# Assign B2 secrets to the Vercel Production environment only.
B2_HTTP_CREDENTIAL_MODE=server
# Legacy header mode is disabled unless this explicit override is set.
# B2_VERCEL_ALLOW_HEADER_CREDENTIAL_MODE=true
B2_APPLICATION_KEY_ID=prod-non-master-key-id
B2_APPLICATION_KEY=prod-non-master-key-secret
B2_ALLOWED_HOSTS=b2-mcp.example.com
# Set browser origins only when browser-based MCP clients are expected.
# B2_ALLOWED_ORIGINS=https://client.example.com
B2_DESTRUCTIVE_POLICY=block
B2_REGISTER_ALL_TOOLS=false
B2_ALLOW_LOCAL_FILES=false
B2_MCP_OUTPUT_FORMAT=json
B2_MCP_RATE_LIMIT_RPS=60
B2_MCP_RATE_LIMIT_BURST=120
B2_MAX_SESSIONS=1000
B2_MAX_SESSIONS_PER_KEY=20

# Public MCP resource URL. This must be the final production /mcp URL.
B2_MCP_PUBLIC_URL=https://b2-mcp.example.com/mcp
B2_MCP_SERVICE_DOCUMENTATION_URL=https://github.com/backblaze-labs/b2-mcp/blob/main/deploy/vercel/README.md

# OAuth resource-server configuration. The route validates tokens by calling
# the authorization server's RFC 7662 introspection endpoint.
B2_OAUTH_ISSUER=https://issuer.example.com/
B2_OAUTH_AUTHORIZATION_ENDPOINT=https://issuer.example.com/oauth2/authorize
B2_OAUTH_TOKEN_ENDPOINT=https://issuer.example.com/oauth2/token
B2_OAUTH_INTROSPECTION_ENDPOINT=https://issuer.example.com/oauth2/introspect
B2_OAUTH_RESOURCE=https://b2-mcp.example.com/mcp
B2_OAUTH_AUDIENCE=https://b2-mcp.example.com/mcp
B2_OAUTH_REQUIRED_SCOPES=
B2_OAUTH_ALLOWED_TOKEN_TYPES=bearer
B2_OAUTH_ALLOWED_ALGORITHMS=RS256,ES256,EdDSA
B2_OAUTH_INTROSPECTION_TIMEOUT_MS=3000
B2_OAUTH_INTROSPECTION_RETRIES=1
B2_OAUTH_INTROSPECTION_RETRY_DELAY_MS=50
B2_OAUTH_INTROSPECTION_CIRCUIT_FAILURES=5
B2_OAUTH_INTROSPECTION_CIRCUIT_OPEN_MS=30000
B2_OAUTH_INTROSPECTION_CACHE_MAX_ENTRIES=1000
B2_OAUTH_INTROSPECTION_CACHE_TTL_SECONDS=300
B2_OAUTH_INTROSPECTION_CACHE_SKEW_SECONDS=30

# Use either client credentials or a bearer token for introspection, depending
# on the selected authorization server. Store these as encrypted Vercel secrets.
B2_OAUTH_INTROSPECTION_CLIENT_ID=resource-server-client-id
B2_OAUTH_INTROSPECTION_CLIENT_SECRET=resource-server-client-secret
# B2_OAUTH_INTROSPECTION_BEARER_TOKEN=resource-server-introspection-token
# Only for reviewed local/lab authorization servers.
# B2_OAUTH_DANGEROUSLY_ALLOW_UNAUTHENTICATED_INTROSPECTION=true

# Preview deployments must not receive production B2 credentials. Set this only
# with a separate disposable read-only key and Vercel Deployment Protection.
# B2_VERCEL_ALLOW_PREVIEW_B2_CREDENTIALS=true
