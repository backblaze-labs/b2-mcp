{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../src/http-handler.ts"],
  "exclude": ["../../node_modules", "dist"]
}
