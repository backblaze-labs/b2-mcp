# Non-secret Worker variables belong in wrangler.jsonc vars.
# Add the values below with `wrangler secret put`; never commit a filled file.
B2_APPLICATION_KEY_ID=prod-non-master-key-id
B2_APPLICATION_KEY=prod-non-master-key-secret
# Add introspection credentials only when B2_OAUTH_INTROSPECTION_ENDPOINT is
# set in Worker vars. JWKS-only Workers set B2_OAUTH_JWKS_URI and
# B2_OAUTH_JWKS_CACHE_TTL_SECONDS in wrangler.jsonc vars, not as secrets.
B2_OAUTH_INTROSPECTION_CLIENT_ID=resource-server-client-id
B2_OAUTH_INTROSPECTION_CLIENT_SECRET=resource-server-client-secret

# Optional alternative to client id/client secret.
# B2_OAUTH_INTROSPECTION_BEARER_TOKEN=resource-server-introspection-token

# Header mode is disabled by the adapter unless this reviewed escape hatch is set.
# B2_CLOUDFLARE_ALLOW_HEADER_CREDENTIAL_MODE=true

# Server mode stays single-tenant unless a review accepts shared B2 access.
# B2_CLOUDFLARE_ALLOW_SHARED_SERVER_CREDENTIAL=true
