# Copy to b2-mcp.env and inject the secret values from your platform secret manager.

B2_HTTP_CREDENTIAL_MODE=server
B2_APPLICATION_KEY_ID_FILE=/run/secrets/b2_application_key_id
B2_APPLICATION_KEY_FILE=/run/secrets/b2_application_key

B2_ALLOWED_HOSTS=mcp.example.com,127.0.0.1,localhost
B2_ALLOWED_ORIGINS=https://client.example.com
B2_DESTRUCTIVE_POLICY=block
B2_REGISTER_ALL_TOOLS=false
B2_MCP_OUTPUT_FORMAT=json

# In server credential mode, these per-key limits apply to the shared
# server-held key and therefore bound aggregate traffic per replica.
B2_MCP_RATE_LIMIT_RPS=120
B2_MCP_RATE_LIMIT_BURST=240
B2_MAX_SESSIONS=1000
B2_MAX_SESSIONS_PER_KEY=200

# Enable only with an explicit sandbox mount in docker-compose.yml.
# B2_ALLOW_LOCAL_FILES=true
# B2_FILE_ROOT=/sandbox

# Principal mode requires a trusted OAuth/mTLS layer that injects verified
# authInfo into the MCP server or a customer wrapper before credential lookup.
# B2_HTTP_CREDENTIAL_MODE=principal
# B2_PRINCIPAL_CREDENTIAL_MAP={"https://auth.example.com#tenant-a-user":"TENANT_A"}
# B2_CREDENTIAL_TENANT_A_APPLICATION_KEY_ID_FILE=/run/secrets/tenant_a_key_id
# B2_CREDENTIAL_TENANT_A_APPLICATION_KEY_FILE=/run/secrets/tenant_a_key
