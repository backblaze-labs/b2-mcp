      "descriptionSha256": "551618b1bfc6a4df209c7992244a028b7cd57b1cdffac80563ce435ffa6d9c95",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "bucket": { "description": "Bucket name or bucketId to inspect.", "type": "string" },
          "limit": {
            "default": 10,
