            "type": "integer"
          },
          "max_scan": {
            "default": 50000,
            "description": "Safety cap on objects scanned (default 50,000, max 500,000). Buckets with millions of files cannot be fully sorted by size in one live call; the scan stops at this cap (or a time budget) and returns truncated=true. Narrow with prefix for an exhaustive ranking of a subtree.",
            "maximum": 500000,
            "minimum": 1000,
            "type": "integer"
          },
          "prefix": {
            "description": "Optional path prefix, e.g. \"checkpoints/\".",
            "type": "string"
