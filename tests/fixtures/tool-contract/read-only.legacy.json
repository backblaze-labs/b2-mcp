          "bucketName": {
            "description": "Filter to a specific bucket by its name",
            "type": "string"
          },
          "bucketTypes": {
            "description": "Filter by bucket types. Defaults to all types.",
            "items": { "enum": ["allPublic", "allPrivate", "snapshot", "all"], "type": "string" },
            "type": "array"
          },
          "limit": {
            "default": 100,
            "description": "Maximum number of buckets to return (default 100, max 1000). The B2 API returns every bucket in one response; this caps how many are surfaced to keep the payload and token cost bounded. If the account has more buckets than the limit, the result is truncated with total_bucket_count and a note — raise limit (up to 1000) or filter by bucketName / bucketId / bucketTypes.",
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "type": "object"
      }
