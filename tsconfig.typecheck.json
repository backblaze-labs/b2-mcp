{
  // Type-check ONLY config: compiles src + tests (the build tsconfig excludes
  // tests, so `npm run build` never caught compile errors in test files —
  // notably integration tests, which otherwise only compile when run with live
  // credentials). Emits nothing; used by the `typecheck` / `npm test` gate.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
