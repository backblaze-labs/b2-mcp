# Backblaze B2 MCP Server — environment variables
# Copy to .env.local (gitignored) for local dev, or set these in your process /
# systemd environment. A single non-master application key covers the B2 native
# API, the S3-compatible API, and key management.

# ── Required for stdio and HTTP server mode ─────────────────────────────────
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Master key — used ONLY by the Partner API tools (falls back to the app key).
# B2_MASTER_KEY_ID=
# B2_MASTER_KEY=
# Default-region accounts can leave B2_REGION unset. Accounts outside
# us-west-004 must set their S3-compatible endpoint region, e.g. us-east-005.
# B2_REGION=us-east-005
# Token appended to the outbound User-Agent (tag a deployment).
# B2_MCP_UA_SUFFIX=
# LLM-facing TextContent.text format for structured successes: json | toon.
# structuredContent remains canonical JSON in both modes. Default: json.
# B2_MCP_OUTPUT_FORMAT=json
# MCP workflow prompts (prompts/list, prompts/get) are off by default.
# Set to true to enable them only after every replica runs prompt-capable code,
# so a rolling HTTP upgrade never advertises prompts before all replicas serve them.
# B2_ENABLE_MCP_PROMPTS=false
# CLI default transport when no positional or --transport argument is supplied:
# stdio | http. Docker images set this to http.
# B2_MCP_TRANSPORT=stdio
# Append redacted structured JSON logs to an absolute file path instead of
# stderr. The file is created owner-only if missing; the parent directory must
# exist. Long-running processes need operator-managed rotation; send SIGHUP
# after rename/create rotation so b2-mcp reopens the file. POSIX only; Windows
# file logging is rejected because owner-only ACLs are not enforced here.
# B2_LOG_FILE=/absolute/path/to/b2-mcp.log
# Durable-secret output mode: file | inline | off. File mode supports
# b2_create_key and b2_create_group_member. b2_reserve_trial_create_account
# requires explicit inline mode because Reserve Trial has no file-mode recovery
# path. Unset defaults to file on stdio and off on HTTP/serverless. inline
# returns the secret to the MCP model context and should be treated as unsafe
# except for explicit local use.
# B2_SECRET_SINK=file
# POSIX-only append-only plaintext JSONL ledger for file mode. Records use top-level
# metadata (ts/tool/recordId) and a result payload. Unset defaults to
# ~/.b2-mcp/secrets.jsonl on stdio. HTTP/serverless file mode requires an
# explicit absolute path plus B2_ALLOW_LOCAL_FILES=true. Rotate, prune, vault,
# or delete this credential ledger under your normal secret-retention policy.
# B2_SECRET_SINK_FILE=/absolute/path/to/b2-mcp-secrets.jsonl
# HTTP/serverless only: required in addition to B2_SECRET_SINK=inline before
# durable secrets may be returned directly in MCP responses.
# B2_ALLOW_INLINE_SECRETS=false

# ── Security / policy (safe defaults shown) ───────────────────────────────────
# Destructive-op gate: confirm | block | allow.
# Per-transport default: stdio = confirm (trusted local user); the internet-facing
# HTTP transport = block (safe-by-default). Set this to opt down/up explicitly.
# B2_DESTRUCTIVE_POLICY=confirm
# MCP form elicitation is on by default for compatible 2026 clients under the
# confirm policy. Set to off/false/0 to use only B2_DESTRUCTIVE_POLICY.
# B2_DESTRUCTIVE_ELICITATION=on
# b2_create_key lockdown. Key-management grants and unscoped write/delete keys
# are refused by default. When B2_MAX_KEY_DURATION_SECONDS is set, non-expiring
# keys and longer durations are refused before any provider create call.
# B2_ALLOW_KEY_MGMT_GRANTS=false
# B2_ALLOW_UNSCOPED_KEYS=false
# B2_MAX_KEY_DURATION_SECONDS=86400
# Capability-aware registration is ON by default: only tools the connected key
# can use are registered (smaller surface, no dead tools). Lookup failures fail
# closed. Set to true to explicitly register the full surface regardless of the
# key's capabilities.
# B2_REGISTER_ALL_TOOLS=false
# Stdio only: bound startup capability discovery so a stalled authorize does not
# block MCP client handshakes indefinitely. Deadline expiry starts fail-closed.
# B2_STDIO_CAPABILITY_TIMEOUT_MS=10000
# Bounded capability-discovery cache TTL and size. Cache identity is secret-bound;
# logs use only non-secret credential fingerprints or verified principal labels.
# B2_CAPABILITY_CACHE_TTL_MS=300000
# B2_CAPABILITY_CACHE_MAX_ENTRIES=10000
# ── HTTP transport only ───────────────────────────────────────────────────────
# Credential mode: headers | server | principal. Unset defaults to headers for
# compatibility with existing hosted clients; set server/principal explicitly for
# deployments where clients send no B2 key.
# server: B2_APPLICATION_KEY_ID / B2_APPLICATION_KEY stay in the server process.
# principal: verified MCP authInfo maps to an env-backed credential reference.
# headers: B2 credential headers must be sent on every MCP request.
# B2_HTTP_CREDENTIAL_MODE=headers
#
# Principal mode map and env-backed secret-broker material.
# B2_PRINCIPAL_CREDENTIAL_MAP={"alice":"TENANT_A"}
# B2_CREDENTIAL_TENANT_A_APPLICATION_KEY_ID=
# B2_CREDENTIAL_TENANT_A_APPLICATION_KEY=
# B2_CREDENTIAL_TENANT_A_MASTER_KEY_ID=
# B2_CREDENTIAL_TENANT_A_MASTER_KEY=
#
# Host/Origin allowlists (DNS-rebinding protection). With NEITHER set, the server
# accepts ONLY localhost — set B2_ALLOWED_HOSTS for any internet-facing deployment.
# B2_ALLOWED_HOSTS=mcp.example.com
# B2_ALLOWED_ORIGINS=https://app.example.com
# Standalone Node HTTP request and header timeouts.
# B2_HTTP_REQUEST_TIMEOUT_MS=30000
# B2_HTTP_HEADERS_TIMEOUT_MS=10000
# Trust X-Forwarded-For / X-Real-IP only behind a trusted proxy that strips
# caller-supplied copies before forwarding to b2-mcp.
# B2_TRUST_PROXY_HEADERS=false
# Per-credential request throttling.
# B2_MCP_RATE_LIMIT_RPS=60
# B2_MCP_RATE_LIMIT_BURST=120
# Concurrent in-flight MCP request caps.
# B2_MAX_SESSIONS=1000
# B2_MAX_SESSIONS_PER_KEY=20
# Local filesystem access for filePath/saveToPath (HTTP: off unless BOTH set).
# B2_ALLOW_LOCAL_FILES=true
# B2_FILE_ROOT=/sandbox/dir
# Idle timeout while streaming s3_get_object results to saveToPath.
# B2_S3_SAVE_TO_PATH_IDLE_TIMEOUT_MS=60000

# ── Deprecated (legacy non-master S3 override; prefer B2_MASTER_KEY_*) ─────────
# B2_APP_KEY_ID=
# B2_APP_KEY=
