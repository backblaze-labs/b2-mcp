{
  "exact": [
    "B2_APPLICATION_KEY",
    "B2_APPLICATION_KEY_ID",
    "B2_APP_KEY",
    "B2_APP_KEY_ID",
    "B2_KEY",
    "B2_KEY_ID",
    "B2_MASTER_KEY",
    "B2_MASTER_KEY_ID"
  ],
  "patterns": ["^B2_CREDENTIAL_.+_(?:APP_KEY|APPLICATION_KEY|MASTER_KEY)(?:_ID)?$", "^LIVE_B2_.+$"],
  "vercelBuildSensitiveExact": [
    "B2_OAUTH_INTROSPECTION_BEARER_TOKEN",
    "B2_OAUTH_INTROSPECTION_CLIENT_SECRET",
    "OAUTH_CLIENT_SECRET",
    "VERCEL_TOKEN"
  ],
  "vercelBuildSensitivePatterns": [
    "^B2_OAUTH_.*(?:SECRET|TOKEN)$",
    "^OAUTH_.*(?:SECRET|TOKEN)$",
    "^VERCEL_.*(?:BYPASS|SECRET|TOKEN)$"
  ],
  "vercelBuildForbiddenPatterns": ["^NEXT_PUBLIC_.+$"],
  "logSensitiveExact": [
    "B2_ACCOUNT_ID",
    "B2_LIVE_NOTIFICATION_BUCKET",
    "B2_LIVE_TEST_ACCOUNT_ID",
    "B2_MCP_LIVE_RUN_PREFIX",
    "B2_SMOKE_BUCKET",
    "MCP_AUTHORIZATION",
    "VERCEL_PROTECTION_BYPASS"
  ],
  "liveRequired": ["B2_APPLICATION_KEY_ID", "B2_APPLICATION_KEY"]
}
