{
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "out": "api-docs",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "requiredToBeDocumented": ["Variable", "Function", "Class", "Interface", "TypeAlias"],
  "navigationLinks": {
    "GitHub": "https://github.com/backblaze-labs/b2-mcp",
    "Backblaze": "https://www.backblaze.com/"
  },
  "treatWarningsAsErrors": false,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  }
}
