{
  "entryPoints": [
    "src/index.ts",
    "src/http-server.ts",
    "src/server.ts",
    "src/mcp.ts",
    "src/http-fetch-handler.ts",
    "src/serverless-adapter-runtime.ts",
    "src/oauth-resource-server.ts",
    "src/auth.ts",
    "src/credentials.ts",
    "src/cli.ts",
    "src/request-context.ts",
    "src/version.ts",
    "src/b2/client.ts",
    "src/b2/buckets.ts",
    "src/b2/keys.ts",
    "src/b2/object-lock.ts",
    "src/b2/partner.ts",
    "src/b2/insights.ts",
    "src/b2/report-client.ts",
    "src/s3/aws-sdk-adapter.ts",
    "src/s3/client.ts",
    "src/s3/buckets.ts",
    "src/s3/extras.ts",
    "src/s3/multipart.ts",
    "src/s3/objects.ts",
    "src/s3/presigned.ts",
    "src/utils/types.ts",
    "src/utils/config.ts",
    "src/utils/circuit-breaker.ts",
    "src/utils/concurrency.ts",
    "src/utils/date.ts",
    "src/utils/destructive-gate.ts",
    "src/utils/destructive-elicitation.ts",
    "src/utils/errors.ts",
    "src/utils/fs-guard.ts",
    "src/utils/http-body-limit.ts",
    "src/utils/logger.ts",
    "src/utils/named-error.ts",
    "src/utils/node-web-bridge.ts",
    "src/utils/payload.ts",
    "src/utils/rate-limiter.ts",
    "src/utils/result-serializer.ts",
    "src/utils/retry.ts",
    "src/utils/runtime.ts",
    "src/utils/secret-sanitizer.ts",
    "src/utils/secret-sink.ts",
    "src/utils/secure-append-file.ts",
    "src/utils/tool-capabilities.ts",
    "src/utils/toon-encoder.ts",
    "src/utils/user-agent.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "api-docs",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "requiredToBeDocumented": [
    "Class",
    "Interface",
    "Function",
    "Method",
    "Property",
    "Enum",
    "EnumMember",
    "TypeAlias",
    "Variable",
    "Accessor",
    "Constructor",
    "GetSignature",
    "SetSignature",
    "CallSignature",
    "IndexSignature"
  ],
  "navigationLinks": {
    "GitHub": "https://github.com/backblaze-labs/b2-mcp",
    "Backblaze": "https://www.backblaze.com/"
  },
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  }
}
