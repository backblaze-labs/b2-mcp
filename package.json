{
  "name": "@backblaze-labs/b2-mcp",
  "version": "0.1.0",
  "description": "MCP server for Backblaze B2 with frozen Phase 1 B2 and S3-compatible tool profiles",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "b2-mcp": "dist/index.js",
    "b2-mcp-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backblaze-labs/b2-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/backblaze-labs/b2-mcp/issues"
  },
  "homepage": "https://github.com/backblaze-labs/b2-mcp#readme",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "ts-node src/index.ts",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "node scripts/run-jest-layer.mjs unit",
    "test:contract": "node scripts/run-jest-layer.mjs contract",
    "test:protocol:modern": "node scripts/run-jest-layer.mjs protocol-modern",
    "test:protocol:legacy": "node scripts/run-jest-layer.mjs protocol-legacy",
    "test:protocol": "npm run test:protocol:modern && npm run test:protocol:legacy",
    "test:slow": "node scripts/run-jest-layer.mjs slow",
    "test:coverage": "node scripts/run-jest-layer.mjs coverage",
    "test:integration": "node scripts/reject-live-alias.mjs integration",
    "test:integration:live": "node scripts/require-live-env.mjs integration && node scripts/run-jest-layer.mjs integration-live",
    "test:contract:live": "node scripts/require-live-env.mjs contract && node scripts/run-jest-layer.mjs contract-live",
    "test:package": "npm run build && node scripts/run-jest-layer.mjs package",
    "verify": "npm run typecheck && npm run build && npm run lint && npm run format:check && npm run spell && npm run test:coverage && npm run test:slow && npm run test:package",
    "test:cross-platform": "node scripts/run-cross-platform-tests.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "generate:tool-contract": "npm run build && node scripts/generate-tool-contract.mjs",
    "smoke:package": "npm run build && node scripts/packed-consumer-smoke.mjs",
    "check:runtime-policy": "node scripts/check-runtime-policy.mjs",
    "check:package-budget": "node scripts/check-package-budget.mjs",
    "audit:supply-chain": "npm run audit:supply-chain:denylist -- --packlist && node scripts/audit-supply-chain.mjs",
    "audit:supply-chain:denylist": "node scripts/check-supply-chain-denylist.mjs",
    "probe:500": "npm run build && node scripts/probe-b2-500s.mjs",
    "lint": "node scripts/run-biome.mjs lint src tests scripts",
    "lint:fix": "node scripts/run-biome.mjs lint src tests scripts --write",
    "format": "node scripts/run-biome.mjs format . --write",
    "format:check": "node scripts/run-biome.mjs format .",
    "spell": "cspell lint --no-progress --gitignore"
  },
  "keywords": [
    "mcp",
    "backblaze",
    "b2",
    "cloud-storage",
    "s3",
    "ai"
  ],
  "author": "Backblaze",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@aws-sdk/s3-request-presigner": "3.1103.0",
    "@backblaze-labs/b2-sdk": "0.2.0",
    "@modelcontextprotocol/server": "2.0.0",
    "opossum": "10.0.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@biomejs/biome": "2.5.7",
    "@modelcontextprotocol/client": "2.0.0",
    "@toon-format/toon": "4.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "22.3.0",
    "@types/opossum": "^8.1.9",
    "babel-jest": "^29.7.0",
    "cspell": "^10.0.1",
    "jest": "^29.5.0",
    "jest-junit": "^17.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "files": [
    "dist/**/*",
    "docs/tool-profile-contract.json",
    "docs/TOOL_PROFILES.md",
    "tests/fixtures/tool-contract/*.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.typecheck.json"
        }
      ],
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@toon-format/toon/)"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    }
  }
}
