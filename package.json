{
  "name": "@backblaze/b2-mcp-server",
  "version": "2.1.0",
  "description": "MCP server for Backblaze B2 — full B2 native API + a minimal S3-compatible set (only operations with no native equivalent)",
  "main": "dist/index.js",
  "bin": {
    "b2-mcp-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backblaze-b2-samples/b2-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/backblaze-b2-samples/b2-mcp-server/issues"
  },
  "homepage": "https://github.com/backblaze-b2-samples/b2-mcp-server#readme",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "ts-node src/index.ts",
    "pretest": "npm run typecheck",
    "test": "NODE_ENV=test jest --testPathPattern=tests/unit",
    "test:integration": "NODE_ENV=test jest --testPathPattern=tests/integration",
    "test:contract": "NODE_ENV=test jest --testPathPattern=tests/integration/contract",
    "smoke": "node scripts/smoke-test.mjs",
    "probe:500": "npm run build && node scripts/probe-b2-500s.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "mcp",
    "backblaze",
    "b2",
    "cloud-storage",
    "s3",
    "ai"
  ],
  "author": "Backblaze",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-presigned-post": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.18.1",
    "opossum": "^9.0.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.19.19",
    "@types/opossum": "^8.1.9",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.5.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "overrides": {
    "hono": "^4.12.27",
    "form-data": "^4.0.6"
  }
}
