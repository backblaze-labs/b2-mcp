{
  "name": "@backblaze-labs/b2-mcp",
  "version": "0.1.0",
  "description": "MCP server for Backblaze B2 — full B2 native API + a minimal S3-compatible set (only operations with no native equivalent)",
  "main": "dist/index.js",
  "bin": {
    "b2-mcp": "dist/index.js",
    "b2-mcp-server": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backblaze-labs/b2-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/backblaze-labs/b2-mcp/issues"
  },
  "homepage": "https://github.com/backblaze-labs/b2-mcp#readme",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "ts-node src/index.ts",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-jest-layer.mjs unit -- --testMatch '**/tests/unit/**/*.unit.test.ts'",
    "test:contract": "node scripts/run-jest-layer.mjs contract -- --testMatch '**/tests/contract/**/*.contract.test.ts'",
    "test:protocol:modern": "node scripts/run-jest-layer.mjs protocol-modern -- --testMatch '**/tests/protocol/**/*.modern-protocol.test.ts' --runInBand --testTimeout=30000",
    "test:protocol:legacy": "node scripts/run-jest-layer.mjs protocol-legacy -- --testMatch '**/tests/protocol/**/*.legacy-protocol.test.ts' --runInBand --testTimeout=30000",
    "test:protocol": "npm run test:protocol:modern && npm run test:protocol:legacy",
    "test:slow": "node scripts/run-jest-layer.mjs slow -- --testMatch '**/tests/slow/**/*.slow.test.ts' --runInBand --testTimeout=120000",
    "test:coverage": "node scripts/run-jest-layer.mjs coverage -- --coverage --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=cobertura --coverageDirectory=coverage --testMatch '**/tests/unit/**/*.unit.test.ts' '**/tests/contract/**/*.contract.test.ts' '**/tests/protocol/**/*.modern-protocol.test.ts' '**/tests/protocol/**/*.legacy-protocol.test.ts'",
    "test:integration": "npm run test:integration:live",
    "test:integration:live": "node scripts/require-live-env.mjs integration && node scripts/run-jest-layer.mjs integration-live -- --testMatch '**/tests/live/**/*.integration.live.test.ts' --runInBand --testTimeout=120000",
    "test:contract:live": "node scripts/require-live-env.mjs contract && node scripts/run-jest-layer.mjs contract-live -- --testMatch '**/tests/live/**/*.contract.live.test.ts' --runInBand --testTimeout=120000",
    "test:package": "npm run build && node scripts/run-jest-layer.mjs package -- --testMatch '**/tests/package/**/*.package.test.ts' --runInBand --testTimeout=120000",
    "verify": "npm run typecheck && npm run build && npm run lint && npm run format:check && npm run test:coverage && npm run test:slow && npm run test:package",
    "smoke": "node scripts/smoke-test.mjs",
    "probe:500": "npm run build && node scripts/probe-b2-500s.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "mcp",
    "backblaze",
    "b2",
    "cloud-storage",
    "s3",
    "ai"
  ],
  "author": "Backblaze",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1096.0",
    "@aws-sdk/credential-provider-ini": "3.973.9",
    "@aws-sdk/credential-provider-node": "3.972.75",
    "@aws-sdk/s3-request-presigner": "3.1096.0",
    "@backblaze-labs/b2-sdk": "0.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "axios": "^1.18.1",
    "opossum": "^9.0.0",
    "pino": "^10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@toon-format/toon": "4.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.20.1",
    "@types/opossum": "^8.1.9",
    "babel-jest": "^29.7.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@toon-format/toon/)"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "overrides": {
    "hono": "^4.12.27",
    "form-data": "^4.0.6"
  }
}
